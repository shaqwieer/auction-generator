# Copy to .env before running docker compose in anything but local development.

SECRET_KEY=replace-with-a-long-random-string
ENVIRONMENT=production

# Host ports. Change any that clash with something already running.
DB_PORT=55432
API_PORT=8000
WEB_PORT=3000

# Where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------- storage
#
# Everything the application writes -- template artwork, uploaded spreadsheets,
# the client's photographs, the generated booklets -- lives under one directory.
# The database stores paths, never file contents.
#
# Development (Windows, local): leave this unset. It defaults to the repo's own
# ./backend/var, which is what the dev server and the build scripts already
# use, so a template built on the host is visible in the container immediately.
#
# Production (Linux VPS): point it at a directory outside the project, on a
# disk you back up. It is bind-mounted into the API at /app/var, so the files
# survive a rebuild, a restart, a redeployment and `docker compose down`, and
# no deployment ever needs `docker compose cp`.
#
#   sudo mkdir -p /srv/matbaa/var/{templates,storage}
#   sudo chown -R 0:0 /srv/matbaa/var        # the API container runs as root
#
# MATBAA_VAR=/srv/matbaa/var
#
# Splitting the two halves across disks is possible but rarely wanted; these
# override VAR_ROOT inside the container if set.
# TEMPLATES_ROOT=/app/var/templates
# STORAGE_ROOT=/app/var/storage

# Postgres is the only supported database, in development and in production.
# Inside compose the API uses the service name; these are for running the API
# on the host against the compose database.
# DATABASE_URL=postgresql+psycopg://matbaa:matbaa@localhost:55432/matbaa
# TEST_DATABASE_URL=postgresql+psycopg://matbaa:matbaa@localhost:55432/matbaa_test
